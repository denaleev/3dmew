# Скопируй в .env и заполни:  cp .env.example .env
# Адрес сайта (с https://, без / в конце). Нужен для входа через соцсети.
PUBLIC_URL=https://example.ru
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL (эти же значения использует docker-compose.yml). Пароль: только латиница и цифры.
POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://cards:change_me@127.0.0.1:5432/cards

# Тексты от Claude (необязательно). Без ключа работает распознавание предмета + простые шаблоны.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_FILLS_PER_HOUR=60

# Вход через соцсети: что оставишь пустым, той кнопки просто не будет.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

MAX_UPLOAD_MB=40

# Магазин. Кто управляет магазином: имена (логины) аккаунтов через запятую, маленькими буквами.
# Можно и так: .venv/bin/python -m tools.make_admin имя
ADMIN_LOGINS=
# Самый большой 3MF/STL-файл, который можно прикрепить к карточке, МБ (в deploy/nginx.conf стоит предел 160 МБ)
MAX_MODEL_MB=150
# Сколько файлов можно приложить к заявке на печать
MAX_REQUEST_FILES=10
# Уведомления о новых заказах и заявках в Telegram (необязательно):
# создай бота у @BotFather, напиши ему что-нибудь, chat_id узнай через https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# если с сервера не открывается api.telegram.org (блокировка в РФ): прокси, например socks5://логин:пароль@хост:1080
TELEGRAM_PROXY=
# новые заказы и заявки дублируются письмом на FEEDBACK_EMAIL (нужны SMTP_USER и SMTP_PASSWORD); 0 = не отправлять
NOTIFY_EMAIL=1

# Feedback form: messages also go to this mailbox. For Yandex Mail create an app password
# (id.yandex.ru → Безопасность → Пароли приложений → Почта) and allow mail programs in the mailbox settings.
FEEDBACK_EMAIL=mew.shop@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAX_VIDEO_MB=100

# MAX messenger bot that posts products to your group (token from @MasterBot in MAX)
MAX_BOT_TOKEN=
